# ============================================================================
# VERIFIED-GOOD BASELINE CONFIG  ("May-9 quality")
# ----------------------------------------------------------------------------
# Pair this config with code commit  d5339de  (tag: good-baseline-may9).
# Verified on short_sample/HILAL-HAZM_match_B_up7.mp4 (862 frames):
#   flicker=52, wrong-merges=0, player tracks=28, team_unknown=0.0, homography_ok=0.52
#
# HOW TO USE:
#   1) cp baseline.env .env
#   2) paste your own ROBOFLOW_API_KEY (and HF_TOKEN if used) into .env
#   3) git checkout good-baseline-may9   # to use the matching code
#   4) ./run.sh <your_video.mp4>
#
# SECRETS ARE INTENTIONALLY BLANK — never commit real keys.
# ============================================================================

# ---- Secrets (fill in your own; keep .env gitignored) ----
ROBOFLOW_API_KEY=
HF_TOKEN=

# ---- Models (Roboflow-hosted; your account must have access) ----
PLAYER_MODEL_ID=footballs-player-detection-zkams-zia6c/2
FIELD_MODEL_ID=football-field-detection-f07vi/15

# ---- Runtime ----
FAST_MODE=false
DETECT_EVERY_N=1
HOMOGRAPHY_EVERY_N=1
TEAM_UPDATE_EVERY_N=1
PREPROCESS_ENABLED=true
TEAM_MODE=color
MAX_FRAMES=0
DETECT_UPSCALE=1.0
DEVICE=cpu

# ---- Tracking (BoTSort + ReID) ----
TRACK_ACTIVATION_THRESHOLD=0.25
TRACKER_TYPE=botsort
TRACK_LOW_THRESHOLD=0.10
TRACK_MIN_MATCHING_THRESHOLD=0.72
TRACK_LOST_BUFFER=70
TRACK_MIN_CONSEC_FRAMES=3
BOTSORT_GMC_METHOD=sparseOptFlow
BOTSORT_WITH_REID=true
BOTSORT_REID_MODEL=yolo11n-cls.pt
BOTSORT_PROXIMITY_THRESH=0.5
BOTSORT_APPEARANCE_THRESH=0.8

# ---- ID stabilization ----
ID_RELINK_FRAMES=120
ID_MEMORY_FRAMES=90
ID_RELINK_PX=130
ID_APP_WEIGHT=0.90
ID_AMBIGUITY_MARGIN=0.02
ID_MAX_RELINK_COST=1.45
ID_UNKNOWN_APP_PENALTY=1.10
ID_UNKNOWN_APP_MAX_GAP=12
ID_UNKNOWN_APP_MAX_SPACE_FRAC=0.85
ID_GALLERY_SIZE=36
ID_GALLERY_MIN_ADD_DIST=0.10
ID_FRAME_CONTINUITY_IOU=0.45
ID_FRAME_CONTINUITY_MARGIN=0.03
ID_SPATIAL_RESCUE_MAX_GAP=220
ID_SPATIAL_RESCUE_MARGIN=0.15
ID_SPATIAL_RESCUE_RATIO=0.70
ID_MAX_PLAYER_IDS=26
ID_HARD_REUSE_WHEN_CAPPED=true
ID_LOCK_FRAMES=12
ID_CAPPED_REUSE_MIN_GAP=8

# ---- Detection thresholds ----
DET_CONF=0.30
FIELD_CONF=0.30
KP_CONF=0.50
MIN_AREA_RATIO_PEOPLE=0.00008
MIN_AREA_RATIO_BALL=0.00001
BALL_PAD_PX=10

# ---- Homography (strict = accurate; this is the May-9 setup) ----
H_EMA_ALPHA=0.80
RANSAC_REPROJ_THRESH=3.0
MIN_KP=6
MIN_INLIER_RATIO=0.55
MAX_REPROJ_ERR=8.0
